{
  "name": "umami-mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform mobile automation framework for Android and iOS using WebdriverIO, Appium, Cucumber, BrowserStack and Allure.",
  "type": "module",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "android:local": "wdio run ./config/wdio.android.local.conf.ts",
    "android:cloud": "wdio run ./config/wdio.android.browserstack.conf.ts",
    "ios:cloud": "wdio run ./config/wdio.ios.browserstack.conf.ts",
    "test:smoke:android": "wdio run ./config/wdio.android.browserstack.conf.ts --cucumberOpts.tagExpression=\"@smoke\"",
    "test:regression:android": "wdio run ./config/wdio.android.browserstack.conf.ts --cucumberOpts.tagExpression=\"@regression\"",
    "typecheck": "tsc --noEmit",
    "report:clean": "node -e \"require('fs').rmSync('reports/allure-results', { recursive: true, force: true }); require('fs').rmSync('reports/allure-report', { recursive: true, force: true })\"",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "report:serve": "allure serve reports/allure-results",
    "test:android:report": "npm run android:cloud && npm run report:generate",
    "test:android:report:open": "npm run android:cloud && npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/browserstack-service": "^9.30.1",
    "@wdio/cli": "^9.30.0",
    "@wdio/cucumber-framework": "^9.30.0",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/visual-service": "^10.1.0",
    "allure-commandline": "^2.43.0",
    "appium-uiautomator2-driver": "^8.1.1",
    "expect-webdriverio": "^5.7.0",
    "tsx": "^4.23.1",
    "typescript": "5.9"
  }
}
